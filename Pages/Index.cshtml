@page
@using Datamatiker2SemExam.Models
@model IndexModel
@{

    ViewData["Title"] = "Relaxius Massage";
}

<div class="text-center mt-5">
    <div class="site-height">
    <h1 class="display-4" style="font-weight: 600;">
        Professionel massage med fokus på dig
    </h1>
    <p class="mt-3" style="font-size: 18px;">
        Velkommen til Relaxius Massage – din velvære starter her.
    </p>
    </div>
    <div style="position: relative;" top: 10px; right: 20px; font-size: 13px; line-height: 1.2; text-align: right; opacity: 0.85;">
        <strong>Åbningstider</strong><br />
        Man–Fre: 09:00–17:00<br />
        Lør–Søn: Lukket
    </div>
    @foreach (OpeningHours item in Model.OpeningHours)
    {
        <p>@item.Day (@item.StartTime - @item.EndTime)</p>
    }
</div>