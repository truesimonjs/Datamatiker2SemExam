    @page
@using Datamatiker2SemExam.Models
@model IndexModel
@{
    ViewData["Title"] = "Relaxius Massage";
}

<div class="container pb-5">
    <div class="row align-items-stretch mb-5 g-0">
        <div class="col-md-6 d-flex flex-column justify-content-center gap-3 pe-5">
            <span class="ra-subheading ra-animate-text">Velkommen til Relaxius</span>
            <h1 class="ra-heading ra-animate-text">Professionel massage med fokus på dig</h1>
            <p class="ra-body ra-animate-text">
                Hos Relaxius er vi dedikeret til dit velvære. Vi tilbyder professionelle
                massagebehandlinger i rolige og indbydende omgivelser — skræddersyet til dig.
            </p>
            <div class="d-flex gap-3">
    <a href="/Bookings/CreateBooking" class="ra-btn-filled ra-animate-text">book en tid</a>
    <a href="/Treatments/ViewTreaments" class="ra-btn-outline ra-animate-text">se behandlinger</a>
</div>
        </div>
        <div class="col-md-6 p-0">
            <img src="~/images/stock_massage_1.jpg" alt="Massage behandling" class="ra-hero-image ra-animate-image" />
        </div>
    </div>

    <!-- Opening Hours Section -->
    <div class="container">
    <div class="d-flex gap-2 align-items-center mb-3">
        <i class="bi bi-clock-history ra-heading-icon ra-animate-text"></i>
        <h2 class="ra-heading ra-animate-text">Åbningstider</h2>
    </div>

        <div class="ra-opening-hours-grid">
        @foreach (var openingHour in Model.OpeningHours)
        {
            <div class="ra-opening-hours-item">
                
                <span class="ra-opening-day ra-animate-text">
                    @openingHour.Day
                </span>

                @if (openingHour.ErOpen == true)
                {
                    <span class="ra-opening-time ra-animate-text">
                        @openingHour.StartTime - @openingHour.EndTime
                    </span>
                }
                else
                {
                    <span class="ra-opening-time ra-animate-text">
                        Lukket
                    </span>
                }

            </div>
        }
    </div>
</div>
</div>