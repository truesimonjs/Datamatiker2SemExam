@page
@using Datamatiker2SemExam.Models
@model IndexModel
@{
    ViewData["Title"] = "Relaxius Massage";
}

<div class="container mt-5">
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto text-center">
            <h1 class="display-4" style="font-weight: 600; color: var(--text-dark);">
                Professionel massage med fokus på dig
            </h1>
            <p class="mt-3" style="font-size: 18px; color: var(--text-light);">
                Velkommen til Relaxius Massage – din velvære starter her.
            </p>
        </div>
    </div>

    <!-- Services Section -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <a href="/Treatments/ViewTreaments" class="service-card">
                <div class="service-card-icon">
                    <i class="bi bi-heart"></i>
                </div>
                <div>
                    <h3 class="service-card-title">Behandlinger</h3>
                    <p class="service-card-subtitle">Udforsk vores omfattende behandlinger</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="/Bookings/CreateBooking" class="service-card">
                <div class="service-card-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div>
                    <h3 class="service-card-title">Book Session</h3>
                    <p class="service-card-subtitle">Reserver din massage i dag</p>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="/Kontakt" class="service-card">
                <div class="service-card-icon">
                    <i class="bi bi-telephone"></i>
                </div>
                <div>
                    <h3 class="service-card-title">Kontakt Os</h3>
                    <p class="service-card-subtitle">Få svar på dine spørgsmål</p>
                </div>
            </a>
        </div>
    </div>

    <!-- Opening Hours Section -->
    <div class="row">
        <div class="col-lg-6 mx-auto">
            <div class="opening-hours-card">
                <div class="opening-hours-title">
                    <i class="bi bi-clock-history"></i>
                    Åbningstider
                </div>
                @foreach (OpeningHour item in Model.OpeningHours)
                {
                    <div class="opening-hour-item">
                        <span class="opening-hour-day">@item.Day</span>
                        <span class="opening-hour-status">
                            @if (item.ErOpen == false)
                            {
                                <span>Lukket</span>
                            }
                            else
                            {
                                <span>@item.StartTime - @item.EndTime</span>
                            }
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>