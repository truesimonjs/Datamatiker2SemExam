@page "{id}"
@model Datamatiker2SemExam.Pages.BookingModel
@{
    ViewData["Title"] = "Booking Detaljer";
}

<div class="container mt-5">
    @if (Model.Booking != null)
    {
        <a href="/ViewBooking" class="btn-back">
            <i class="bi bi-chevron-left"></i>
            Tilbage til Bookinger
        </a>

        <div class="booking-detail-header">
            <div class="booking-detail-icon">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="booking-detail-info">
                <h1 class="booking-detail-name">@Model.Booking.Treatment?.Name</h1>
                <div class="booking-detail-specs">
                    <div class="booking-spec">
                        <div class="booking-spec-icon">
                            <i class="bi bi-calendar-event"></i>
                        </div>
                        <div>
                            <div class="booking-spec-label">Start Tid</div>
                            <div class="booking-spec-value">@Model.Booking.StartTime</div>
                        </div>
                    </div>
                    <div class="booking-spec">
                        <div class="booking-spec-icon">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <div class="booking-spec-label">Varighed</div>
                            <div class="booking-spec-value">@Model.Booking.Duration min</div>
                        </div>
                    </div>
                    <div class="booking-spec">
                        <div class="booking-spec-icon">
                            <i class="bi bi-person"></i>
                        </div>
                        <div>
                            <div class="booking-spec-label">Kunde</div>
                            <div class="booking-spec-value">@Model.Booking.Customer?.Name</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="booking-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <div>
                <strong>Bekræft Sletning</strong>
                <p class="mb-0">Er du sikker på at du vil slette denne booking? Denne handling kan ikke fortrydes.</p>
            </div>
        </div>

        <div class="booking-actions">
            <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Booking.Id" class="d-inline">
                <button type="submit" class="btn-confirm-delete" onclick="return confirm('Er du helt sikker?')">
                    <i class="bi bi-trash"></i>
                    Ja, slet booking
                </button>
            </form>
            <a asp-page="/ViewBooking" class="btn-cancel-delete">
                <i class="bi bi-x-circle"></i>
                Nej, behold booking
            </a>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Booking ikke fundet</h4>
            <p>Denne booking kunne ikke blive fundet.</p>
            <a href="/ViewBooking" class="btn btn-primary">Tilbage til Bookinger</a>
        </div>
    }
</div>
