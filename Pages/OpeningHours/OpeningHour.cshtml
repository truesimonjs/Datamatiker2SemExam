@page "{id}"
@model Datamatiker2SemExam.Pages.OpeningHourModel
@{
}

@if (Model.OpeningHour == null)
{
    <div class="alert alert-danger" role="alert">
        opening hour kunne ikke blive fundet
    </div>
}
else
{
    <h2>Opening hour @Model.OpeningHour?.Id</h2>

    <form method="post">
        <div class="form-group mb-3">
            <label asp-for="NewTime" class="control-label "></label>
            <input asp-for="NewTime" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="ChangeOpeningState" type="checkbox" class="form-check-input" id="changeOpeningState" />
            <label asp-for="ChangeOpeningState" class="form-check-label"></label>
        </div>
        <button class="btn btn-primary">Ændre</button>
    </form>
}