<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Relaxius</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Datamatiker2SemExam.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@100;200;300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light">
            <div class="container-fluid px-4">
                <a class="navbar-brand ra-brand ra-animate-text" href="/">
                    <span class="ra-brand-name">Relaxius</span>
                    <span class="ra-brand-tagline">Massage &amp; Wellness</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link ra-link ra-animate-text" style="animation-delay: 0.1s;" asp-page="/Treatments/ViewTreaments">Behandlinger</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ra-link ra-animate-text" style="animation-delay: 0.2s;" asp-page="/Kontakt">Kontact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ra-link ra-animate-text" style="animation-delay: 0.3s;" asp-page="/Privacy">Omkring</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link ra-link ra-animate-text" style="animation-delay: 0.4s;" asp-page="/Bookings/ViewBooking">Bookninger</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link ra-link ra-animate-text" style="animation-delay: 0.5s;" asp-page="/Bookings/CreateBooking">Lav Bookning</a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link ra-link ra-animate-text" style="animation-delay: 0.6s;" asp-area="" asp-page="/OpeningHours/Admin">Admin</a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="navbar-auth-buttons">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="ra-user-info ra-animate-text" style="animation-delay: 0.3s;">
                                logget ind som @User.Identity.Name
                            </span>
                            <a class="ra-logout-button ra-animate-text" style="animation-delay: 0.4s;" asp-area="" asp-page="/UserLogin/Logout">Logout</a>
                        }
                        else
                        {
                            <a class="ra-btn-outline ra-animate-text" style="animation-delay: 0.3s;" asp-page="/UserLogin/Login">Sign In</a>
                            <a class="ra-btn-filled ra-animate-text" style="animation-delay: 0.4s;" asp-page="/UserLogin/Register">Sign Up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3" style="padding-top: 130px;">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Relaxius - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>