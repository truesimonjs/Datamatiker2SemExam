@page
@model Datamatiker2SemExam.Pages.Bookings.CreateBookingModel
@{
    <form method="post">
        <div class="form-group mb-3">
            <label asp-for="@Model.Element.StartTime" class="control-label"></label>
            <input asp-for="@Model.Element.StartTime" class="form-control" />
            <span asp-validation-for="@Model.Element.StartTime" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="@Model.Element.Duration" class="control-label"></label>
            <input asp-for="@Model.Element.Duration" class="form-control" />
            <span asp-validation-for="@Model.Element.Duration" class="text-danger"></span>
        </div>
        



        <p>
            <div class="form-group mb-3">
                <input type="submit" value="Opret" class="btn btn-outline-primary" />
            </div>
        </p>
    </form>
}
