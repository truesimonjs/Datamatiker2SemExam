@page
@model Datamatiker2SemExam.Pages.Bookings.CreateBookingModel
@{
    <form method="post">
        <div class="form-group mb-3">
            <label asp-for="@Model.Element.StartTime" class="control-label"></label>
            <input asp-for="@Model.Element.StartTime" type="date" class="form-control" />
            <span asp-validation-for="@Model.Element.StartTime" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="@Model.Element.Duration" class="control-label"></label>
            <input asp-for="@Model.Element.Duration" class="form-control" />
            <span asp-validation-for="@Model.Element.Duration" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Kunde</label>
            <select asp-for="@Model.Element.CustomerId" asp-items="@Model.CustomerList" class="form-control"></select>
            <span asp-validation-for="@Model.Element.CustomerId" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label class="control-label">Ansat</label>
            <select asp-for="@Model.Element.WorkerId" asp-items="@Model.WorkerList" class="form-control"></select>
            <span asp-validation-for="@Model.Element.WorkerId" class="text-danger"></span>
        </div>
        



        <p>
            <div class="form-group mb-3">
                <input type="submit" value="Opret" class="btn btn-outline-primary" />
            </div>
        </p>
    </form>
}
