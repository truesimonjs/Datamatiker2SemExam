@page "{id}"
@model Datamatiker2SemExam.Pages.ThreatmentModel
@{
    ViewData["Title"] = "Behandling Detaljer";
}

<div class="container mt-5">
    @if (Model.Treatment != null)
    {
        <a href="/Treatments/ViewTreaments" class="btn-back">
            <i class="bi bi-chevron-left"></i>
            Tilbage til Behandlinger
        </a>

        <div class="treatment-detail-header">
            <div class="treatment-detail-icon">
                <i class="bi bi-spa"></i>
            </div>
            <div class="treatment-detail-info">
                <h1 class="treatment-detail-name">@Model.Treatment.Name</h1>
                <div class="treatment-detail-specs">
                    <div class="treatment-spec">
                        <div class="treatment-spec-icon">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <div class="treatment-spec-label">Varighed</div>
                            <div class="treatment-spec-value">@Model.Treatment.Duration min</div>
                        </div>
                    </div>
                    <div class="treatment-spec">
                        <div class="treatment-spec-icon">
                            <i class="bi bi-tag"></i>
                        </div>
                        <div>
                            <div class="treatment-spec-label">Pris</div>
                            <div class="treatment-spec-value">DKK @Model.Treatment.Price</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="treatment-actions">
            <form method="post" class="d-inline">
                <button type="submit" class="btn-delete-treatment" onclick="return confirm('Er du sikker på at du vil slette denne behandling?')">
                    <i class="bi bi-trash"></i>
                    Slet Behandling
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">Behandling ikke fundet</h4>
            <p>Denne behandling kunne ikke blive fundet.</p>
            <a href="/Treatments/ViewTreaments" class="btn btn-primary">Tilbage til Behandlinger</a>
        </div>
    }
</div>
