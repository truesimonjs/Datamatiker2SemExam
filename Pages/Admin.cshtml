@page
@model Datamatiker2SemExam.Pages.AdminModel
@{


   ViewData["Title"] = "Relaxius Massage";
}

<h1>Administrer åbningstider</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <td>Dag</td>
            <th>Åbner</th>
            <th>Lukker</th>
            <th>Åben?</th>
            <th>Handling</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OpeningHours)
        {
            <tr>
                <td>
                    <a asp-page="/Admin/Details" asp-route-id="@item.Id">
                        @item.Day
                    </a>
                </td>
                <td>@item.StartTime</td>
                <td>@item.EndTime</td>
                <td>@(item.ErOpen ? "Ja" : "Nej")</td>

                <td>
                    <form method="post" asp-page-handler="ToggleOpen" style="display:inline;">
                        <input type="hidden" name="Id" value="@item.Id" />
                        <button type="submit" class="btn btn-warning btn-sm">
                            @(item.ErOpen ? "Luk" : "Åben")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>