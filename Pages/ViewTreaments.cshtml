@page
@model Datamatiker2SemExam.Pages.ViewTreamentsModel
@{
    ViewData["Title"] = "Behandlinger";
}

<div class="container">
    <div class="treatments-header">
        <p class="treatments-subtitle">VORES SERVICES</p>
        <h1 class="treatments-title">Skræddersyede Behandlinger til Din Velvære</h1>
        <p class="treatments-description">
            Vælg blandt vores udvalg af ekspertisk udformede massageterapi, hver designet til at imødekomme dine unikke behov.
        </p>
    </div>

    <div class="row g-4">
        @foreach (var elem in Model.Treatments)
        {
            <div class="col-md-6 col-lg-4">
                <a href="/Threatment/@elem.Id" style="text-decoration: none; color: inherit;">
                    <div class="treatment-card">
                        <div class="treatment-card-icon">
                            <i class="bi bi-leaf"></i>
                        </div>
                        <h3 class="treatment-card-name">@elem.Name</h3>
                        <div class="treatment-card-footer">
                            <div class="treatment-duration">
                                <i class="bi bi-clock"></i>
                                <span>@elem.Duration min</span>
                            </div>
                            <div class="treatment-price">DKK @elem.Price</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>