@page
@model Datamatiker2SemExam.Pages.ViewBookingModel

<div class="container mt-4">

    <h1 class="mb-4">Bookinger</h1>

    @if (Model.Bookings == null || !Model.Bookings.Any())
    {
        <div class="alert alert-info">
            Ingen bookinger fundet.
        </div>
    }
    else
    {
        <table class="table table-striped table-bordered">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Starttid</th>
                    <th>Varighed</th>
                    <th>Kunde</th>
                    <th>Behandling</th>
                    <th>Medarbejder</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var booking in Model.Bookings)
                {
                    <tr>
                        <td>@booking.Id</td>

                        <td>
                            @if (booking.StartTime != null)
                            {
                                @Convert.ToBase64String(booking.StartTime)
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td>@booking.Duration</td>

                        <td>@booking.Customer?.Name</td>

                        <td>
                            @booking.Treatment != null
                            ? $"Price: {booking.Treatment.Price} / Duration: {booking.Treatment.Duration}"
                            : "-"
                        </td>

                        <td>@booking.Worker?.Name</td>
                    </tr>
                }
            </tbody>

        </table>
    }

</div>