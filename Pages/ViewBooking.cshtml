@page
@model Datamatiker2SemExam.Pages.ViewBookingModel

<h1>Bookings</h1>
<p>Herunder kan du se dine bookinger.</p>

<div class="container">
    <div class="row">

        @foreach (var elem in Model.Bookings)
        {
            <div class="col-md-4 p-3">

                <div class="card shadow" style="width: 18rem;">
                    <div class="card-body d-flex flex-column">

                        <h4>Start Time: @elem.StartTime</h4>

                        <p>Varighed: @elem.Duration</p>

                        <p>Kunde: @elem.Customer?.Name</p>

                        <p>Pris: @elem.Treatment?.Price</p>

                        <p>Medarbejder: @elem.Worker?.Name</p>

                    </div>
                </div>

            </div>
        }

    </div>
</div>